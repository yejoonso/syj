
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEM Simulator PRO</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 20px;
  background: #101722;
  color: #edf4ff;
  font-family: Arial, sans-serif;
}

main {
  max-width: 1250px;
  margin: auto;
}

h1 {
  text-align: center;
  color: #65d5ff;
}

.sub {
  text-align: center;
  color: #9aadc3;
}

.panel {
  background: #1b293a;
  border: 1px solid #34485e;
  border-radius: 12px;
  padding: 16px;
  margin: 16px 0;
}

h2 { font-size: 18px; }

.workspace {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 15px;
}

canvas {
  display: block;
  width: 100%;
  background: #091321;
  border-radius: 8px;
}

#scene { aspect-ratio: 760 / 430; }
#result { aspect-ratio: 4 / 3; }

.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}

button, select {
  padding: 11px 15px;
  border: 0;
  border-radius: 7px;
  color: white;
  background: #167fc0;
  cursor: pointer;
}

button:hover { background: #269cde; }

select {
  background: #30445b;
}

.control-item {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 13px;
  color: #bdcde0;
}

input { accent-color: #48caff; }

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.stat {
  background: #263b52;
  padding: 14px;
  border-radius: 8px;
  text-align: center;
  font-size: 12px;
  color: #b6c9df;
}

.stat strong {
  display: block;
  font-size: 20px;
  color: #65d5ff;
  margin-top: 8px;
}

.progress {
  height: 9px;
  background: #34465b;
  border-radius: 10px;
  overflow: hidden;
  margin-top: 12px;
}

#bar {
  width: 0%;
  height: 100%;
  background: #37c4ff;
}

.note {
  font-size: 13px;
  color: #aabbd0;
  line-height: 1.8;
}

@media(max-width:800px) {
  .workspace { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}
</style>
</head>

<body>
<main>

<h1>SEM Simulator PRO</h1>
<p class="sub">
Scanning Electron Microscope Simulation
</p>

<div class="panel">
<h2>① SEM 작동 장치 및 전자 이동</h2>
<canvas id="scene" width="760" height="430"></canvas>
<p class="note">
청록색: 1차 전자 / 노란색: 2차 전자 /
보라색: 전자 검출기
</p>
</div>

<div class="workspace">

<div class="panel">
<h2>② 시료 표면</h2>
<canvas id="surface" width="480" height="360"></canvas>
<p class="note">
시료의 높이와 표면 굴곡을 명암으로 표시합니다.
</p>
</div>

<div class="panel">
<h2>③ SEM 이미지 생성</h2>
<canvas id="result" width="384" height="288"></canvas>
<p class="note">
검출된 2차 전자 신호를 픽셀의 밝기로 변환합니다.
</p>
<button onclick="saveImage()">이미지 PNG 저장</button>
</div>

</div>

<div class="panel">
<h2>④ 실험 조건 설정</h2>

<div class="controls">

<button onclick="startScan()">▶ 주사 시작</button>
<button onclick="pauseScan()">Ⅱ 일시정지</button>
<button onclick="resetScan()">↻ 초기화</button>
<button onclick="newSample()">새 시료 생성</button>

<label class="control-item">
시료 재질
<select id="material">
<option value="metal">금속</option>
<option value="semiconductor">반도체</option>
<option value="polymer">고분자</option>
</select>
</label>

<label class="control-item">
주사 속도
<input id="speed" type="range" min="1" max="10" value="5">
<span id="speedText">5</span>
</label>

<label class="control-item">
검출기 수집 효율
<input id="efficiency" type="range" min="20" max="100" value="80">
<span id="effText">80%</span>
</label>

</div>
</div>

<div class="panel">
<h2>⑤ 측정 데이터</h2>

<div class="stats">
<div class="stat">
주사 진행률
<strong id="progress">0%</strong>
</div>

<div class="stat">
주사 위치
<strong id="position">0, 0</strong>
</div>

<div class="stat">
검출 신호
<strong id="signal">0</strong>
</div>

<div class="stat">
측정 횟수
<strong id="count">0</strong>
</div>
</div>

<div class="progress">
<div id="bar"></div>
</div>
</div>

<div class="panel">
<h2>⑥ SEM 이미지 생성 원리</h2>
<p class="note">
1. 전자총에서 1차 전자빔이 발생합니다.<br>
2. 전자빔이 시료 표면의 한 좌표에 도달합니다.<br>
3. 시료와 1차 전자의 상호작용을 통해 2차 전자가 발생합니다.<br>
4. 2차 전자 중 검출기 방향으로 수집되는 신호를 계산합니다.<br>
5. 검출 신호를 디지털 데이터로 변환합니다.<br>
6. 각 좌표의 신호를 픽셀 밝기로 변환하여 SEM 이미지를 만듭니다.
</p>
</div>

</main>

<script>

// ==========================================
// 1. 기본 설정
// ==========================================

const scene = document.getElementById("scene");
const ctx = scene.getContext("2d");

const surfaceCanvas = document.getElementById("surface");
const sctx = surfaceCanvas.getContext("2d");

const result = document.getElementById("result");
const rctx = result.getContext("2d");

const W = 96;
const H = 72;

const TOTAL = W * H;

const GUN = {x: 135, y: 65};
const DETECTOR = {x: 650, y: 85};

const SAMPLE = {
  x: 190,
  y: 190,
  w: 500,
  h: 210
};

let heights = [];
let signals = [];
let brightness = [];

let index = 0;
let running = false;
let animation = null;

let currentSignal = 0;
let lastTime = 0;
let phase = 0;

let speed = 5;
let efficiency = 0.8;

let material = "metal";


// ==========================================
// 2. 시료 표면 생성
// ==========================================

function gaussian(x, y, cx, cy, sx, sy) {
  return Math.exp(
    -(
      Math.pow((x-cx)/sx, 2) +
      Math.pow((y-cy)/sy, 2)
    )
  );
}

function createSample() {

  heights = [];

  for(let y=0; y<H; y++) {

    let row = [];

    for(let x=0; x<W; x++) {

      let u = x/W;
      let v = y/H;

      let z =
        0.60 * gaussian(u,v,0.28,0.30,0.11,0.15) +
        0.85 * gaussian(u,v,0.68,0.62,0.15,0.12) +
        0.35 * gaussian(u,v,0.82,0.20,0.07,0.09) +
        0.12 * Math.sin(u*35) * Math.cos(v*29) +
        0.06 * Math.sin(u*80+v*25);

      row.push(z);
    }

    heights.push(row);
  }
}


// ==========================================
// 3. 표면의 기울기 계산
// ==========================================

function getNormal(x,y) {

  const left = heights[y][Math.max(0,x-1)];
  const right = heights[y][Math.min(W-1,x+1)];

  const up = heights[Math.max(0,y-1)][x];
  const down = heights[Math.min(H-1,y+1)][x];

  const dx = (right-left)*4;
  const dy = (down-up)*4;

  let nx = -dx;
  let ny = -dy;
  let nz = 1;

  const length = Math.sqrt(nx*nx+ny*ny+nz*nz);

  return {
    x: nx/length,
    y: ny/length,
    z: nz/length
  };
}


// ==========================================
// 4. 시료와 검출기 관계
// ==========================================

function getSignal(x,y) {

  const normal = getNormal(x,y);

  // 검출기 방향을 나타내는 가상 벡터
  const detectorVector = {
    x: 0.75,
    y: -0.35,
    z: 0.75
  };

  const dot =
    normal.x*detectorVector.x +
    normal.y*detectorVector.y +
    normal.z*detectorVector.z;

  // 표면 기울기에 따른 검출 효율
  const collection = Math.max(0.08, dot);

  // 재질별 2차 전자 발생 계수
  const yields = {
    metal: 0.75,
    semiconductor: 0.95,
    polymer: 1.15
  };

  const yieldFactor = yields[material];

  // 표면의 굴곡과 모서리 효과를 단순화
  const slope =
    Math.sqrt(normal.x**2 + normal.y**2);

  const edgeEffect = 1 + slope*0.65;

  // 시료의 높이가 높은 지점에 대한 간단한 표면 효과
  const heightEffect = 1 + heights[y][x]*0.15;

  // 검출 신호
  let signal =
    yieldFactor *
    collection *
    edgeEffect *
    heightEffect *
    efficiency;

  // 작은 통계적 변동을 위한 고정 패턴
  const variation =
    0.96 + 0.08 *
    ((Math.sin(x*12.3+y*7.7)+1)/2);

  signal *= variation;

  return Math.max(0, signal);
}


// ==========================================
// 5. 전체 신호 사전 계산
// ==========================================

function calculateSignals() {

  signals = [];

  let maxSignal = 0;
  let minSignal = Infinity;

  for(let y=0; y<H; y++) {

    let row = [];

    for(let x=0; x<W; x++) {

      const value = getSignal(x,y);

      row.push(value);

      maxSignal = Math.max(maxSignal,value);
      minSignal = Math.min(minSignal,value);
    }

    signals.push(row);
  }

  // 신호를 0~255 명도 값으로 정규화
  brightness = signals.map(row =>
    row.map(value => {

      const normalized =
        (value-minSignal) /
        (maxSignal-minSignal+0.000001);

      return Math.round(255*normalized);
    })
  );
}


// ==========================================
// 6. 시료 표면 이미지 출력
// ==========================================

function drawSurface() {

  const image = sctx.createImageData(W,H);

  for(let y=0; y<H; y++) {

    for(let x=0; x<W; x++) {

      const z = heights[y][x];

      const gray = Math.max(
        35,
        Math.min(220, 65+z*140)
      );

      const i = (y*W+x)*4;

      image.data[i] = gray;
      image.data[i+1] = gray;
      image.data[i+2] = gray;
      image.data[i+3] = 255;
    }
  }

  const temp = document.createElement("canvas");
  temp.width = W;
  temp.height = H;

  temp.getContext("2d").putImageData(image,0,0);

  sctx.clearRect(0,0,480,360);
  sctx.drawImage(temp,0,0,480,360);
}


// ==========================================
// 7. SEM 장치 화면
// ==========================================

function drawScene() {

  ctx.clearRect(0,0,760,430);

  ctx.fillStyle = "#091321";
  ctx.fillRect(0,0,760,430);

  // 전자총
  ctx.fillStyle = "#71869e";
  ctx.fillRect(95,25,80,65);

  ctx.fillStyle = "#b5c9de";
  ctx.fillRect(120,85,30,30);

  ctx.fillStyle = "white";
  ctx.font = "15px Arial";
  ctx.fillText("전자총",105,17);

  // 전자 검출기
  ctx.fillStyle = "#7454ad";
  ctx.fillRect(610,35,85,60);

  ctx.fillStyle = "#b99aff";
  ctx.fillRect(635,90,35,25);

  ctx.fillText("전자 검출기",605,25);

  // 시료
  ctx.fillStyle = "#667789";
  ctx.fillRect(
    SAMPLE.x,
    SAMPLE.y,
    SAMPLE.w,
    SAMPLE.h
  );

  // 시료 표면 패턴
  const temp = document.createElement("canvas");
  temp.width = W;
  temp.height = H;

  const image = temp.getContext("2d").createImageData(W,H);

  for(let y=0;y<H;y++) {
    for(let x=0;x<W;x++) {

      const z=heights[y][x];
      const g=Math.round(75+z*130);
      const i=(y*W+x)*4;

      image.data[i]=g;
      image.data[i+1]=g;
      image.data[i+2]=g;
      image.data[i+3]=255;
    }
  }

  temp.getContext("2d").putImageData(image,0,0);

  ctx.drawImage(
    temp,
    SAMPLE.x,
    SAMPLE.y,
    SAMPLE.w,
    SAMPLE.h
  );

  ctx.strokeStyle="#dce7f2";
  ctx.strokeRect(
    SAMPLE.x,
    SAMPLE.y,
    SAMPLE.w,
    SAMPLE.h
  );

  ctx.fillStyle="white";
  ctx.fillText("시료",410,420);

  // 주사 위치
  if(index<TOTAL && index>0) {

    const x=index%W;
    const y=Math.floor(index/W);

    const px=SAMPLE.x+x/W*SAMPLE.w;
    const py=SAMPLE.y+y/H*SAMPLE.h;

    ctx.strokeStyle="#4edbff";
    ctx.lineWidth=1;

    ctx.beginPath();
    ctx.arc(px,py,7,0,Math.PI*2);
    ctx.stroke();
  }
}


// ==========================================
// 8. 전자 이동 애니메이션
// ==========================================

function drawElectron(x,y,color) {

  ctx.beginPath();
  ctx.arc(x,y,5,0,Math.PI*2);

  ctx.fillStyle=color;
  ctx.shadowColor=color;
  ctx.shadowBlur=15;
  ctx.fill();
  ctx.shadowBlur=0;
}

function animateElectron() {

  if(!running) return;

  const x=index%W;
  const y=Math.floor(index/W);

  const px=SAMPLE.x+x/W*SAMPLE.w;
  const py=SAMPLE.y+y/H*SAMPLE.h-
            heights[y][x]*15;

  const now=performance.now();

  const duration=220/speed;

  if(!lastTime) lastTime=now;

  phase=(now-lastTime)/duration;

  drawScene();

  if(phase<0.5) {

    // 1차 전자: 전자총 -> 시료
    const t=phase*2;

    const ex=GUN.x+15+(px-GUN.x-15)*t;
    const ey=GUN.y+65+(py-GUN.y-65)*t;

    ctx.strokeStyle="#4edbff";
    ctx.lineWidth=2;

    ctx.beginPath();
    ctx.moveTo(GUN.x+15,GUN.y+65);
    ctx.lineTo(ex,ey);
    ctx.stroke();

    drawElectron(ex,ey,"#4edbff");

  } else {

    // 2차 전자: 시료 -> 검출기
    const t=(phase-0.5)*2;

    const ex=px+(DETECTOR.x+35-px)*t;
    const ey=py+(DETECTOR.y+60-py)*t;

    ctx.strokeStyle="#ffcb69";
    ctx.lineWidth=2;

    ctx.beginPath();
    ctx.moveTo(px,py);
    ctx.lineTo(ex,ey);
    ctx.stroke();

    drawElectron(ex,ey,"#ffcb69");
  }

  if(phase>=1) {

    currentSignal=signals[y][x];

    drawResultPixel(x,y);

    index++;

    lastTime=now;

    updateStats();

    if(index>=TOTAL) {
      finishScan();
      return;
    }
  }

  animation=requestAnimationFrame(animateElectron);
}


// ==========================================
// 9. SEM 이미지 생성
// ==========================================

function drawResultPixel(x,y) {

  const g=brightness[y][x];

  const pixelWidth=result.width/W;
  const pixelHeight=result.height/H;

  rctx.fillStyle=`rgb(${g},${g},${g})`;

  rctx.fillRect(
    x*pixelWidth,
    y*pixelHeight,
    Math.ceil(pixelWidth)+1,
    Math.ceil(pixelHeight)+1
  );
}

function clearResult() {

  rctx.fillStyle="#000";
  rctx.fillRect(0,0,result.width,result.height);
}


// ==========================================
// 10. 제어 기능
// ==========================================

function startScan() {

  if(running) return;

  if(index>=TOTAL) return;

  running=true;
  lastTime=performance.now();

  animation=requestAnimationFrame(animateElectron);
}

function pauseScan() {

  running=false;

  if(animation) {
    cancelAnimationFrame(animation);
  }

  animation=null;
  lastTime=0;

  drawScene();
}

function resetScan() {

  pauseScan();

  index=0;
  currentSignal=0;

  clearResult();
  drawScene();
  updateStats();
}

function newSample() {

  resetScan();

  createSample();
  calculateSignals();
  drawSurface();
  drawScene();
}


// ==========================================
// 11. 완료 처리
// ==========================================

function finishScan() {

  running=false;

  drawScene();

  document.getElementById("progress").textContent="100%";

  document.getElementById("bar").style.width="100%";

  document.getElementById("position").textContent="완료";

  document.getElementById("signal").textContent=
    currentSignal.toFixed(3);

  document.getElementById("count").textContent=TOTAL;
}


// ==========================================
// 12. 데이터 표시
// ==========================================

function updateStats() {

  const percent=Math.floor(index/TOTAL*100);

  document.getElementById("progress").textContent=
    percent+"%";

  document.getElementById("bar").style.width=
    percent+"%";

  const x=index%W;
  const y=Math.floor(index/W);

  document.getElementById("position").textContent=
    x+", "+y;

  document.getElementById("signal").textContent=
    currentSignal.toFixed(3);

  document.getElementById("count").textContent=index;
}


// ==========================================
// 13. 설정 변경
// ==========================================

document.getElementById("speed").oninput=function() {

  speed=Number(this.value);

  document.getElementById("speedText").textContent=
    speed;
};

document.getElementById("efficiency").oninput=function() {

  efficiency=Number(this.value)/100;

  document.getElementById("effText").textContent=
    this.value+"%";

  calculateSignals();
};

document.getElementById("material").onchange=function() {

  material=this.value;

  calculateSignals();
};


// ==========================================
// 14. 이미지 저장
// ==========================================

function saveImage() {

  const link=document.createElement("a");

  link.download="SEM_image.png";

  link.href=result.toDataURL("image/png");

  link.click();
}


// ==========================================
// 15. 최초 실행
// ==========================================

createSample();
calculateSignals();

drawSurface();
drawScene();

clearResult();
updateStats();

</script>
</body>
</html>
